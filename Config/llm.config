models:
  - id: kimi-k2.6
    display_name: "Kimi-k2.6:cloud"
    provider: ollama
    ollama_tag: "kimi-k2.6:cloud"
    temperature: 0.2

  - id: qwen-3.5
    display_name: "Qwen-3.5:cloud"
    provider: ollama
    ollama_tag: "qwen3.5:cloud"
    temperature: 0.2

  - id: glm-5.2
    display_name: "GLM-5.2:cloud"
    provider: ollama
    ollama_tag: "glm-5.2:cloud"
    temperature: 0.2

  - id: deepseek-v4-pro
    display_name: "DeepSeek-V4-Pro:cloud"
    provider: ollama
    ollama_tag: "deepseek-v4-pro:cloud"
    temperature: 0.2

  - id: gpt-5.4
    display_name: "GPT-5.4"
    provider: openai        # native fallback: not available in Ollama's cloud catalog
    model_name: "gpt-5.4"
    api_key_env: OPENAI_API_KEY
    temperature: 0.2

  - id: claude-sonnet-4.6
    display_name: "Claude Sonnet 4.6"
    provider: anthropic      # native fallback: not available in Ollama's cloud catalog
    model_name: "claude-sonnet-4-6"
    api_key_env: ANTHROPIC_API_KEY
    temperature: 0.2

runs_per_model: 3
